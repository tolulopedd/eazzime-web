{
  "name": "eazzime-technologies",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "python3 -m http.server 3000 --directory out",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "prebuild": "node scripts/build-knowledge.mjs",
    "test:browser": "playwright test",
    "eval:sales": "node scripts/evaluate-sales-ai.mjs",
    "dev:full": "npm run build && npx --yes netlify-cli dev --dir out --framework '#static' --port 8888 --no-open"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
