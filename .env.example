NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_LINKEDIN_URL=

# Server-only: set these in Netlify with Functions scope. Never use NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=EazziMe Website <website@eazzime.com>

# AI sales assistant — SERVER ONLY (Netlify Functions scope)
OPENAI_API_KEY=
# Choose a text model available to your API project that supports Responses API.
OPENAI_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -hex 32
LEAD_TOKEN_SECRET=
TURNSTILE_SECRET_KEY=
SALES_EMAIL=info@eazzime.com
# Digits only, international format. Leave blank to hide WhatsApp.
SALES_WHATSAPP=
# Free 30-minute event URL. Cal.com supports signed confirmation callbacks below.
CONSULTATION_BOOKING_URL=
CAL_WEBHOOK_SECRET=
LEAD_RETENTION_DAYS=180

# Public build-time values (safe to publish; not secret keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: uses an existing window.gtag, or loads this measurement ID after opt-in.
NEXT_PUBLIC_GA4_ID=
